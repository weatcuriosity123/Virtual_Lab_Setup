# Copy to .env. Replace this legacy code before starting the API.
CLASS_ACCESS_CODE=REPLACE_WITH_YOUR_CLASS_CODE
PUBLIC_BASE_URL=https://lab.example.com
SESSION_MINUTES=60
MAX_SESSIONS=4
STUDENT_IMAGE=linux-lab:1.0
DOCKER_NETWORK=linux-lab-net

# Set false after creating classroom codes if you want to disable legacy admission.
ALLOW_LEGACY_CLASS_CODE=true
