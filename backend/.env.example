# Copy to .env. Replace this legacy code before starting the API.
CLASS_ACCESS_CODE=REPLACE_WITH_YOUR_CLASS_CODE
PUBLIC_BASE_URL=https://lab.example.com
SESSION_MINUTES=60
MAX_SESSIONS=4
STUDENT_IMAGE=linux-lab:1.0
DOCKER_NETWORK=linux-lab-net

# Set false after creating classroom codes if you want to disable legacy admission.
ALLOW_LEGACY_CLASS_CODE=true

# Optional verified login: configure Access and enroll students before enabling.
AUTH_MODE=off
CF_ACCESS_TEAM_URL=
CF_ACCESS_AUD=

# Comma-separated verified admin emails. Empty disables admin access.
ADMIN_EMAILS=

# Pilot only: comma-separated template IDs with persistent /config homes.
# Requires Cloudflare identity and a student subscription; see docs/student-storage.md.
PERSISTENT_HOME_TEMPLATES=

# Enable only through scripts/install-quota-storage.sh after deploying the API.
PERSISTENT_STORAGE_BACKEND=legacy
